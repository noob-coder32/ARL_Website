PORT=5000
# Allowed frontend origins for CORS (supports comma-separated list for multiple domains)
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.netlify.app

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-db-password
PGDATABASE=arl_website
PGSSL=false

# Alternatively, you can use a single connection string:
# DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/arl_website

# JWT Authentication Settings
JWT_SECRET=your-super-secret-jwt-key-change-in-production-do-not-share
JWT_EXPIRE=24h

# Email Reply Settings (Optional - for direct email replies via Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Assam Roofing Limited" <info@assamroofing.com>
