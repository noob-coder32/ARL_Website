PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DB_SERVER=your-sql-server-host
DB_PORT=1433
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Authentication Settings
JWT_SECRET=your-super-secret-jwt-key-change-in-production-do-not-share
JWT_EXPIRE=24h

# Email Reply Settings (Optional - for direct email replies via Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Assam Roofing Limited" <info@assamroofing.com>
